{
  "name": "namma-startup",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "build:sites": "vinext build",
    "test:smoke": "node scripts/smoke.mjs",
    "db:generate": "drizzle-kit generate",
    "format": "prettier --write src db scripts"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "drizzle-orm": "0.45.2",
    "fast-xml-parser": "5.11.1",
    "leaflet": "1.9.4",
    "lucide-react": "1.39.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.6",
    "@openai/sites-vite-plugin": "0.2.0",
    "@types/leaflet": "1.9.20",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.8",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "prettier": "3.6.2",
    "react-server-dom-webpack": "19.2.8",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.9",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24"
  }
